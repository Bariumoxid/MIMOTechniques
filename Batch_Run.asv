          % 'CQITable', "Table1"),
            };
num_sets = length(param_sets);

% 2. 核心技巧：全局关闭图像显示，但保留后台绘图功能
% 这样 figure 不会弹出来打断你，但 saveas 和 exportgraphics 依然可以完美把图存进文件夹
set(0, 'DefaultFigureVisible', 'off'); 

disp('================================================');
disp(['开始执行批量 5G 模拟任务，总共需要运行 ', num2str(num_sets), ' 个 Sets.']);
disp('================================================');

for i = 1:num_sets
    p = param_sets{i};
    
    fprintf('[%s] 正在启动 Set %d / %d...\n', char(datetime('now')), i, num_sets);
    fprintf('------------------------------------------------------\n');
    fprintf('  ▶ Frames        : %d\n', p.Frames);
    fprintf('  ▶ Channel       : %s\n', p.SimChannel);
    fprintf('  ▶ RIRestriction : %s\n', mat2str(p.RIRestriction)); % 数组转字符串打印
    fprintf('  ▶ Doppler Shift : %g Hz\n', p.Doppler_Shift);
    fprintf('  ▶ PO            : [%d, %d]\n', p.PO(1), p.PO(2));
    fprintf('  ▶ CQIMode       : %s\n', p.CQIMode);
    fprintf('  ▶ SubbandSize   : %d\n', p.SubbandSize);
    fprintf('  ▶ CodeBookMode  : %d\n', p.CodeBookMode);
    fprintf('  ▶ CQITable      : %s\n', p.CQITable);
    fprintf('======================================================\n...\n');
    
    % 3. 容错处理：使用 try-catch 防止某个参数集出错导致整个假期的程序崩溃
    try
        % 调用刚才写好的 Function
        FUNCTION_Run_5G_Simulation(...
            p.Frames, ...
            p.SimChannel, ...
            p.RIRestriction, ...
            p.Doppler_Shift, ...
            p.PO, ...
            p.CQIMode, ...
            p.SubbandSize, ...
            p.CodeBookMode, ...
            p.CQITable, ...
            i);
        fprintf('[%s] Set %d 运行成功！数据已保存。\n', char(datetime('now')), i);
    catch ME
        % 如果报错了，记录错误信息，程序会继续跑下一个 Set
        fprintf(2, '[%s] 警告：Set %d 运行失败！错误信息：%s\n', char(datetime('now')), i, ME.message);
        % （可选）将错误信息写入日志文件
        fid = fopen('Error_Log.txt', 'a');
        fprintf(fid, 'Run %d 失败 (%s): %s\n', i, char(datetime('now')), ME.message);
        fclose(fid);
    end
    
    % 4. 防过热机制：每个模拟结束后，强制休息 5 分钟 (300秒)
    if i < num_sets
        fprintf('进入冷却阶段，暂停 5 分钟以防止电脑过热...\n\n');
        pause(300); 
    end
end

% 恢复全局图像显示设置（跑完了恢复原样）
set(0, 'DefaultFigureVisible', 'on');
disp('所有批量模拟任务执行完毕！');