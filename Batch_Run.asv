% Batch_Controller.m
clear; clc; close all;
warning('off', 'all');
poolobj = gcp('nocreate'); % 获取当前已有的并行池（如果有的话）
if isempty(poolobj)
    poolobj = parpool('local', 13);
elseif poolobj.NumWorkers ~= 13
    delete(poolobj); % 关掉不对的池子
    poolobj = parpool('local', 13); % 重新开 21 个线程
end
poolobj.IdleTimeout = Inf; 
disp(['并行池配置完毕，当前线程数: ', num2str(poolobj.NumWorkers)]);

% 1. 定义你要跑的参数集 (使用结构体数组方便管理)
